# openapi-typescript / openapi-fetch still pin `typescript@^5.x` as a peer, but the
# project is on TypeScript 6 (the codegen emits plain type strings and the client is
# types-only, so they work with TS6 in practice). Accept the conservative peer pin
# rather than hold the toolchain back. Real incompatibilities surface in vue-tsc/build.
legacy-peer-deps=true

# npm 12 defaults `allow-remote=none` and is meant to exempt tarballs served by
# the configured registry, but resolving a lockfile from scratch
# (`--package-lock-only`, which is how Renovate updates it) refetches the
# registry tarball of any package that declares `bundleDependencies` by its
# URL, and that path misses the exemption (npm/cli#9800). Here that is
# @tailwindcss/oxide-wasm32-wasi, pulled in by @tailwindcss/vite, so every
# tailwind bump and every lockfile refresh failed with EALLOWREMOTE. `all` is
# npm 11's default, the version Node 24 ships and CI runs; this repo has no
# URL dependencies. Drop this line once npm fixes the exemption.
allow-remote=all
